UPSTREAM_BASE_URL=https://your-openai-compatible-endpoint/v1
UPSTREAM_API_KEY=none
MODEL_ID=your-model-id
MAX_TOKENS=8192
DAILY_LIMIT=50
RATE_LIMIT_TZ=Asia/Hong_Kong
# Behind Cloudflare: CF-Connecting-IP is used automatically.
# Set to true only if behind a non-Cloudflare trusted proxy.
TRUST_FORWARDED_FOR=false
DB_PATH=./usage.db
AGENTS_DIR=./agents
