UPSTREAM_BASE_URL=https://cantonesellm.votee.dev/v1
UPSTREAM_API_KEY=none
MODEL_ID=CantoneseLLM
MAX_TOKENS=2048
DAILY_LIMIT=20
RATE_LIMIT_TZ=Asia/Hong_Kong
